{
  "name": "bodyrig-webCLI",
  "version": "0.1.0",
  "description": "Client-side, offline mocap retargeting: skinned character + BVH in, animated web-optimized GLB out. Zero egress.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "vendor": "node scripts/vendor.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:matrix": "node tests/matrix.mjs",
    "test": "npm run test:unit && npm run test:matrix",
    "test:update-golden": "node tests/matrix.mjs --update-golden"
  },
  "keywords": [
    "mocap",
    "retargeting",
    "bvh",
    "fbx",
    "glb",
    "gltf",
    "offline",
    "pwa",
    "client-side",
    "webCLI"
  ],
  "author": "Tejaswi Gowda",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "esbuild": "^0.28.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  }
}
